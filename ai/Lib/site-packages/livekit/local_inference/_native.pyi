from __future__ import annotations

from collections.abc import Mapping
from typing import Any
import numpy as np

EOT_MAX_SAMPLES: int
"""Maximum PCM length accepted by ``EOT.predict`` (32000 samples = 2.0 s @ 16 kHz)."""

VAD_WINDOW_SAMPLES: int
"""Exact PCM length required by ``VAD.predict`` (512 samples = 32 ms @ 16 kHz)."""

EOT_THRESHOLDS: Mapping[str, float]
"""Read-only default thresholds for ``EOT.predict``, keyed by ISO 639-1 code.

A probability below a language's threshold means the turn is unlikely to
have ended. The values are calibrated for the bundled model.
"""


class EOT:
    """Single-shot end-of-turn detector.

    The native model singleton is shared across instances; ``close()``
    only flips a per-instance flag. ``predict`` releases the GIL.
    """
    def __init__(self) -> None: ...
    def predict(self, pcm: np.ndarray, turn_samples: int | None = None) -> float:
        """Return P(turn ended) in [0, 1] for the end of a user turn.

        ``pcm`` is the most recent int16 PCM of the turn, at most
        ``EOT_MAX_SAMPLES``; longer inputs raise ``ValueError``. When the
        turn is longer than ``pcm``, pass its full length in
        ``turn_samples``, counted from the user's first speech: the
        model uses the turn duration as a feature. ``None`` (or any value
        below ``len(pcm)``) means ``len(pcm)``. Inputs shorter than 1760
        samples (0.11 s) return 0.0.
        """
    def close(self) -> None: ...
    def __enter__(self) -> EOT: ...
    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> None: ...


class VAD:
    """Streaming voice-activity detector (16 kHz).

    State is per-instance: each call consumes one 512-sample chunk and
    updates the LSTM hidden / cell state plus a 64-sample audio context.
    ``reset()`` zeroes the state without destroying the instance.
    ``predict`` releases the GIL.
    """
    def __init__(self) -> None: ...
    def predict(self, pcm: np.ndarray) -> float:
        """Return P(speech) in [0, 1] for a 512-sample int16 chunk.

        ``pcm`` must be exactly ``VAD_WINDOW_SAMPLES`` samples long.
        Wrong length raises ``ValueError``.
        """
    def reset(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> VAD: ...
    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> None: ...


def init_eot() -> None:
    """Eagerly init the EOT model singleton (~315 MB).

    Call from a prewarm hook to front-load the cost out of the request
    path. Idempotent; the first ``EOT()`` construction calls this
    implicitly.
    """

def init_vad() -> None:
    """Eagerly init the VAD model singleton.

    Prewarm counterpart to ``init_eot``; idempotent. The first
    ``VAD()`` construction calls this implicitly.
    """

def _parallelism() -> int: ...
